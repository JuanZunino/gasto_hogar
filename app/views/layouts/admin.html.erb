<% content_for :head do %>
  <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css",
        integrity: "sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB",
        crossorigin: "anonymous", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js",
        integrity: "sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI",
        crossorigin: "anonymous", defer: true, "data-turbo-track": "reload" %>
<% end %>

<% content_for :content do %>
  <%= render "admin/shared/navbar" if current_admin %>
  <main class="container py-4">
    <% if notice.present? %>
      <div class="alert alert-success" role="status"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="alert alert-danger" role="alert"><%= alert %></div>
    <% end %>
    <%= yield %>
  </main>
<% end %>

<%= render template: "layouts/application" %>
