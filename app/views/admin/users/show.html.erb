<h1><%= @user.name %></h1>

<p><strong>Email:</strong> <%= @user.email %></p>
<p><strong>Rol:</strong> <%= @user.role %></p>
<p><strong>Fecha de creación:</strong> <%= @user.created_at.to_date %></p>

<p>
  <%= link_to "Editar", edit_admin_user_path(@user) %>
  <%= link_to "Volver a usuarios", admin_users_path %>
</p>
<%= button_to "Eliminar", admin_user_path(@user), method: :delete,
  form: { data: { turbo_confirm: "¿Eliminar este usuario?" } } %>
