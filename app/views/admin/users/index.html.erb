<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <h1 class="h2 mb-0">Usuarios</h1>
  <%= link_to "Nuevo usuario", new_admin_user_path, class: "btn btn-primary" %>
</div>

<% if @users.empty? %>
  <p class="alert alert-info mb-0">No hay usuarios registrados.</p>
<% else %>
  <div class="table-responsive border rounded">
    <table class="table table-striped table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col">Nombre</th>
          <th scope="col">Email</th>
          <th scope="col">Rol</th>
          <th scope="col">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td><span class="badge text-bg-secondary"><%= user.role %></span></td>
            <td>
              <div class="d-flex flex-wrap gap-2">
                <%= link_to "Ver", admin_user_path(user), class: "btn btn-outline-secondary btn-sm" %>
                <%= link_to "Editar", edit_admin_user_path(user), class: "btn btn-outline-primary btn-sm" %>
                <%= button_to "Eliminar", admin_user_path(user), method: :delete, class: "btn btn-outline-danger btn-sm",
                  form: { class: "m-0", data: { turbo_confirm: "¿Eliminar este usuario?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
