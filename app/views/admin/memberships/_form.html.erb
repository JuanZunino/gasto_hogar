<div class="row">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <%= form_with model: [:admin, membership] do |form| %>
          <% if membership.errors.any? %>
            <div class="alert alert-danger" role="alert">
              <h2 class="h5">No se pudo guardar el integrante:</h2>
              <ul class="mb-0">
                <% membership.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label :user_id, "Usuario", class: "form-label" %>
            <%= form.collection_select :user_id, @users, :id, :name, { prompt: "Seleccionar usuario" }, { required: true, class: "form-select" } %>
          </div>
          <div class="mb-3">
            <%= form.label :household_id, "Hogar", class: "form-label" %>
            <%= form.collection_select :household_id, @households, :id, :name, { prompt: "Seleccionar hogar" }, { required: true, class: "form-select" } %>
          </div>
          <div class="mb-3">
            <%= form.label :role, "Rol", class: "form-label" %>
            <%= form.select :role, ["owner", "member"], {}, { class: "form-select" } %>
          </div>
          <%= form.submit "Guardar integrante", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
