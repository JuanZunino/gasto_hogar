<h1 class="h2 mb-4 text-break"><%= @household.name %></h1>

<div class="card shadow-sm mb-4">
  <div class="card-body p-4">
    <p class="text-break"><strong>Descripción:</strong> <%= @household.description.presence || "Sin descripción" %></p>
  </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
  <%= link_to "Editar", edit_admin_household_path(@household), class: "btn btn-outline-primary" %>
  <%= link_to "Volver a hogares", admin_households_path, class: "btn btn-outline-secondary" %>
  <%= button_to "Eliminar", admin_household_path(@household), method: :delete, class: "btn btn-outline-danger",
    form: { class: "m-0", data: { turbo_confirm: "¿Eliminar este hogar?" } } %>
</div>

<h2 class="h4 mb-3">Integrantes actuales</h2>

<% if @memberships.empty? %>
  <p class="alert alert-info mb-0">No hay integrantes en este hogar.</p>
<% else %>
  <div class="table-responsive border rounded">
    <table class="table table-striped table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col">Nombre</th>
          <th scope="col">Email</th>
          <th scope="col">Rol</th>
        </tr>
      </thead>
      <tbody>
        <% @memberships.each do |membership| %>
          <tr>
            <td><%= membership.user.name %></td>
            <td><%= membership.user.email %></td>
            <td><span class="badge text-bg-secondary"><%= membership.role %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
