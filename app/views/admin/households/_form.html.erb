<%= form_with model: [:admin, household] do |form| %>
  <% if household.errors.any? %>
    <div role="alert">
      <h2>No se pudo guardar el hogar:</h2>
      <ul>
        <% household.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p>
    <%= form.label :name, "Nombre" %><br>
    <%= form.text_field :name, required: true %>
  </p>
  <p>
    <%= form.label :description, "Descripción" %><br>
    <%= form.text_area :description %>
  </p>
  <%= form.submit "Guardar hogar" %>
<% end %>
