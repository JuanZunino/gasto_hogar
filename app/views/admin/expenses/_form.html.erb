<div class="row">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <%= form_with model: [:admin, expense] do |form| %>
          <% if expense.errors.any? %>
            <div class="alert alert-danger" role="alert">
              <h2 class="h5">No se pudo guardar el gasto:</h2>
              <ul class="mb-0">
                <% expense.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label :description, "Descripción", class: "form-label" %>
            <%= form.text_field :description, required: true, class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= form.label :amount, "Importe", class: "form-label" %>
            <%= form.number_field :amount, required: true, step: "0.01", min: "0.01", class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= form.label :date, "Fecha", class: "form-label" %>
            <%= form.date_field :date, required: true, class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= form.label :notes, "Notas", class: "form-label" %>
            <%= form.text_area :notes, class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= form.label :user_id, "Usuario", class: "form-label" %>
            <%= form.collection_select :user_id, @users, :id, :name, { prompt: "Seleccionar usuario" }, { required: true, class: "form-select" } %>
          </div>
          <div class="mb-3">
            <%= form.label :category_id, "Categoría", class: "form-label" %>
            <%= form.collection_select :category_id, @categories, :id, :name, { prompt: "Seleccionar categoría" }, { required: true, class: "form-select" } %>
          </div>
          <div class="mb-3">
            <%= form.label :household_id, "Hogar", class: "form-label" %>
            <%= form.collection_select :household_id, @households, :id, :name, { include_blank: "Personal" }, { class: "form-select" } %>
          </div>
          <div class="mb-3">
            <%= form.label :receipt, "Comprobante (opcional)", class: "form-label" %>
            <%= form.file_field :receipt, accept: "image/*,application/pdf", class: "form-control" %>
            <% if expense.receipt.attached? %>
              <div class="form-text text-break">Comprobante actual: <%= expense.receipt.filename %>.
              Se conservará si no seleccionas uno nuevo.</div>
            <% end %>
          </div>
          <%= form.submit "Guardar gasto", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
