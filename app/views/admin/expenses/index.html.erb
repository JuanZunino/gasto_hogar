<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <h1 class="h2 mb-0">Gastos</h1>
  <%= link_to "Nuevo gasto", new_admin_expense_path, class: "btn btn-primary" %>
</div>

<% if @expenses.empty? %>
  <p class="alert alert-info mb-0">No hay gastos registrados.</p>
<% else %>
  <div class="table-responsive border rounded">
    <table class="table table-striped table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col">Fecha</th>
          <th scope="col">Descripción</th>
          <th scope="col">Importe</th>
          <th scope="col">Usuario</th>
          <th scope="col">Categoría</th>
          <th scope="col">Hogar</th>
          <th scope="col">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @expenses.each do |expense| %>
          <tr>
            <td><%= expense.date %></td>
            <td><%= expense.description %></td>
            <td><%= number_with_precision(expense.amount, precision: 2) %></td>
            <td><%= expense.user.name %></td>
            <td><%= expense.category.name %></td>
            <td><%= expense.household&.name || "Personal" %></td>
            <td>
              <div class="d-flex flex-wrap gap-2">
                <%= link_to "Ver", admin_expense_path(expense), class: "btn btn-outline-secondary btn-sm" %>
                <%= link_to "Editar", edit_admin_expense_path(expense), class: "btn btn-outline-primary btn-sm" %>
                <%= button_to "Eliminar", admin_expense_path(expense), method: :delete, class: "btn btn-outline-danger btn-sm",
                  form: { class: "m-0", data: { turbo_confirm: "¿Eliminar este gasto?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
