<div class="row">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <%= form_with model: [:admin, category] do |form| %>
          <% if category.errors.any? %>
            <div class="alert alert-danger" role="alert">
              <h2 class="h5">No se pudo guardar la categoría:</h2>
              <ul class="mb-0">
                <% category.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label :name, "Nombre", class: "form-label" %>
            <% if @default_category %>
              <%= form.text_field :name, value: category.name_in_database, disabled: true, class: "form-control" %>
              <p class="form-text">Categoría predeterminada: solo se puede modificar su descripción.</p>
            <% else %>
              <%= form.text_field :name, required: true, class: "form-control" %>
            <% end %>
          </div>
          <div class="mb-3">
            <%= form.label :description, "Descripción", class: "form-label" %>
            <%= form.text_area :description, class: "form-control" %>
          </div>
          <%= form.submit "Guardar categoría", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
