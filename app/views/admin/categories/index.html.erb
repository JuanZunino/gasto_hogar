<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <h1 class="h2 mb-0">Categorías</h1>
  <%= link_to "Nueva categoría", new_admin_category_path, class: "btn btn-primary" %>
</div>

<% if @categories.empty? %>
  <p class="alert alert-info mb-0">No hay categorías registradas.</p>
<% else %>
  <div class="table-responsive border rounded">
    <table class="table table-striped table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col">Nombre</th>
          <th scope="col">Descripción</th>
          <th scope="col">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td><%= category.name %></td>
            <td><%= category.description %></td>
            <td>
              <div class="d-flex flex-wrap gap-2">
                <%= link_to "Ver", admin_category_path(category), class: "btn btn-outline-secondary btn-sm" %>
                <%= link_to "Editar", edit_admin_category_path(category), class: "btn btn-outline-primary btn-sm" %>
                <%= button_to "Eliminar", admin_category_path(category), method: :delete, class: "btn btn-outline-danger btn-sm",
                  form: { class: "m-0", data: { turbo_confirm: "¿Eliminar esta categoría?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
