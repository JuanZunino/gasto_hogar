<h1>Categorías</h1>

<p><%= link_to "Nueva categoría", new_admin_category_path %></p>

<% if @categories.empty? %>
  <p>No hay categorías registradas.</p>
<% else %>
  <table>
    <thead>
      <tr><th>Nombre</th><th>Descripción</th><th>Acciones</th></tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= category.name %></td>
          <td><%= category.description %></td>
          <td>
            <%= link_to "Ver", admin_category_path(category) %>
            <%= link_to "Editar", edit_admin_category_path(category) %>
            <%= button_to "Eliminar", admin_category_path(category), method: :delete,
              form: { data: { turbo_confirm: "¿Eliminar esta categoría?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
